# ============================================================
# 企智通 QZT - 环境变量配置 (本地数据库版本)
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.local.example .env
# 2. 根据需要修改密码（默认已生成随机密码）
# 3. 运行：docker compose up -d
# ============================================================

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=qzt_root_password_change_me
DB_PASSWORD=qzt_password_change_me

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=qzt_redis_password_change_me

# ============================================
# JWT 密钥
# ============================================
JWT_SECRET=change-this-to-a-random-secret

# ============================================
# 域名配置
# ============================================
DOMAIN_NAME=localhost
ADMIN_DOMAIN=admin.localhost

# ============================================
# 资源限制配置（由部署脚本自动设置）
# ============================================
# BACKEND_MEM_LIMIT=1g
# FRONTEND_MEM_LIMIT=256m
# WEBSITE_MEM_LIMIT=512m
# REDIS_MEM_LIMIT=256m
# MYSQL_MEM_LIMIT=1g
# BACKEND_CPU_LIMIT=1
# FRONTEND_CPU_LIMIT=0.5
# WEBSITE_CPU_LIMIT=0.5
# REDIS_CPU_LIMIT=0.5
# MYSQL_CPU_LIMIT=1
