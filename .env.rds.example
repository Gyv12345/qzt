# ============================================================
# 企智通 QZT - 环境变量配置 (RDS 版本)
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.rds.example .env
# 2. 填写下面的配置信息
# 3. 运行：docker compose -f docker-compose.rds.yml up -d
# ============================================================

# ============================================
# RDS 数据库配置（必填）
# ============================================
RDS_HOST=rm-xxxxx.mysql.rds.aliyuncs.com
RDS_PORT=3306
RDS_USERNAME=your_db_username
RDS_PASSWORD=your_db_password
RDS_DATABASE=qzt_db

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=$(openssl rand -hex 16 2>/dev/null || echo "change_redis_password")

# ============================================
# JWT 密钥（自动生成）
# ============================================
JWT_SECRET=$(openssl rand -hex 32 2>/dev/null || echo "change_jwt_secret")

# ============================================
# 域名配置（可选）
# ============================================
DOMAIN_NAME=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# ============================================
# OSS 文件上传配置（可选）
# ============================================
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# ============================================
# 资源限制配置（由部署脚本自动设置）
# ============================================
# 2C2G 配置示例
# BACKEND_MEM_LIMIT=512m
# FRONTEND_MEM_LIMIT=128m
# WEBSITE_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=128m
# BACKEND_CPU_LIMIT=1
# FRONTEND_CPU_LIMIT=0.5
# WEBSITE_CPU_LIMIT=0.5
# REDIS_CPU_LIMIT=0.5
