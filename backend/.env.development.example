# 环境配置
NODE_ENV=development

# 数据库配置
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# MySQL配置(生产环境使用)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=qzt_user
# DB_PASSWORD=your-password
# DB_DATABASE=qzt_prod

# Redis配置
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# JWT配置
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# 服务端口
BACKEND_PORT=7890

# 应用配置
APP_NAME=企账通
APP_URL=http://localhost:7890
API_URL=http://localhost:7890
FRONTEND_URL=http://localhost:3456

# OSS配置（阿里云）
OSS_REGION=oss-cn-heyuan
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# 支付配置
PAYMENT_MODE=mock

# ========== 并发优化配置 ==========

# PM2 Cluster 模式（生产环境推荐开启）
PM2_CLUSTER_ENABLED=false  # true: 开启多进程, false: 单进程

# 数据库连接池配置（仅 MySQL）
# DIRECT_DATABASE_URL=mysql://qzt_user:password@localhost:3306/qzt_prod?connection_limit=20&pool_timeout=30

# API 限流配置
THROTTLE_TTL=60000         # 时间窗口(毫秒)，默认60秒
THROTTLE_LIMIT=100         # 请求数量限制，默认100次（开发环境可设为50）
