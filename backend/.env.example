# ==========================================
# 企智通 (QZT) Backend 环境变量配置
# ==========================================
#
# 使用说明：
# 1. 复制此文件为 .env.local (开发环境) 或部署到服务器
# 2. 根据实际环境填写配置值
# 3. .env.local 已被 .gitignore 忽略，不会提交到仓库
#
# 配置优先级（从高到低）：
# - .env.local (本地开发，不提交)
# - .env (默认环境)
# - 系统环境变量

# ============================================================
# 环境配置
# ============================================================
NODE_ENV=development                    # 环境类型: development | production | test

# ============================================================
# 数据库配置
# ============================================================
# 数据库提供商: sqlite (开发) | mysql (生产)
DATABASE_PROVIDER=sqlite

# SQLite 数据库文件路径（开发环境）
DATABASE_URL=file:./dev.db

# MySQL 配置（生产环境，当 DATABASE_PROVIDER=mysql 时必填）
# DB_HOST=your-rds-endpoint.rds.aliyuncs.com
# DB_PORT=3306
# DB_USERNAME=qzt_user
# DB_PASSWORD=your-strong-password
# DB_DATABASE=qzt_prod

# ============================================================
# Redis 配置
# ============================================================
REDIS_ENABLED=false                      # 是否启用 Redis（缓存、队列）
# REDIS_HOST=localhost                    # Redis 主机地址
# REDIS_PORT=6379                         # Redis 端口
# REDIS_PASSWORD=                         # Redis 密码
# REDIS_DB=0                             # Redis 数据库索引 (0-15)

# ============================================================
# OSS 配置（阿里云对象存储）
# ============================================================
OSS_ENABLED=false                        # 是否启用 OSS 文件上传
# OSS_REGION=oss-cn-hangzhou             # OSS 区域
# OSS_ACCESS_KEY_ID=your-access-key-id    # OSS 访问密钥 ID
# OSS_ACCESS_KEY_SECRET=your-secret      # OSS 访问密钥 Secret
# OSS_BUCKET=your-bucket-name            # OSS 存储桶名称
# OSS_ENDPOINT=                          # OSS 自定义域名（可选）
# OSS_PREFIX=qzt/                        # OSS 文件前缀

# ============================================================
# JWT 认证配置
# ============================================================
# JWT 密钥（至少 32 个字符，生产环境必须修改！）
JWT_SECRET=change-this-jwt-secret-in-production-min-32-chars
JWT_EXPIRES_IN=7d                       # Token 过期时间

# ============================================================
# 应用配置
# ============================================================
APP_NAME=企智通                          # 应用名称
APP_URL=http://localhost:7890            # 应用完整 URL
API_URL=http://localhost:7890            # API 服务 URL
FRONTEND_URL=http://localhost:3456       # 前端 URL（用于 CORS）
BACKEND_PORT=7890                        # 后端服务端口

# ============================================================
# CORS 配置
# ============================================================
# CORS_ORIGINS=http://localhost:3456,https://your-domain.com  # 允许的跨域源（逗号分隔）
# CORS_CREDENTIALS=true                 # 是否允许携带凭证

# ============================================================
# 2FA 双因素认证配置
# ============================================================
TOTP_APP_NAME=企智通                     # TOTP 应用名称
# TOTP_ENCRYPTION_KEY=your-32-char-encryption-key  # TOTP 加密密钥（可选）

# ============================================================
# 并发优化配置
# ============================================================
PM2_CLUSTER_ENABLED=false                # 是否启用 PM2 集群模式
THROTTLE_TTL=60000                      # 限流时间窗口（毫秒）
THROTTLE_LIMIT=100                      # 限流请求数

# ============================================================
# 支付配置
# ============================================================
PAYMENT_MODE=mock                       # 支付模式: mock | alipay | wechat

# ============================================================
# e签宝配置（可选）
# ============================================================
# ESIGN_APP_ID=your_app_id
# ESIGN_APP_SECRET=your_app_secret
# ESIGN_URL=https://openapi.esign.cn

# ============================================================
# 日志配置
# ============================================================
# LOGS_RETENTION_DAYS=90                # 日志保留天数
