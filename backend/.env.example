# ==========================================
# QZT Backend 环境变量配置示例
# ==========================================
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# ------------------- 环境配置 -------------------
# 环境类型: development, production, test
NODE_ENV=development

# ------------------- 数据库配置 -------------------
# 数据库提供商: sqlite (开发), mysql (生产)
DATABASE_PROVIDER=sqlite
# SQLite 数据库文件路径
DATABASE_URL=file:./dev.db

# MySQL配置(生产环境使用)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=qzt_user
# DB_PASSWORD=your-strong-password
# DB_DATABASE=qzt_prod

# ------------------- Redis配置 -------------------
# 是否启用 Redis (用于会话、队列等)
REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ------------------- JWT配置 -------------------
# JWT 密钥 (至少32个字符，生产环境必须修改)
JWT_SECRET=your-jwt-secret-key-change-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# ------------------- 服务端口 -------------------
# 后端服务端口
BACKEND_PORT=3456

# ------------------- 应用配置 -------------------
# 应用名称
APP_NAME=企智通
# 应用完整 URL
APP_URL=http://localhost:7890
# API 服务 URL
API_URL=http://localhost:3456
# 前端 URL (用于 CORS)
FRONTEND_URL=http://localhost:7890

# ------------------- 2FA 配置 -------------------
# TOTP 应用名称
TOTP_APP_NAME=企智通
# TOTP 加密密钥 (用于加密存储 2FA 密钥，建议设置)
# TOTP_ENCRYPTION_KEY=your-32-char-encryption-key

# ------------------- 并发优化配置 -------------------
# 是否启用 PM2 集群模式
PM2_CLUSTER_ENABLED=false
# 限流 TTL (毫秒)
THROTTLE_TTL=60000
# 限流请求数
THROTTLE_LIMIT=100

# ------------------- 日志配置 -------------------
# 日志保留天数
LOGS_RETENTION_DAYS=90

# ------------------- e签宝配置 -------------------
ESIGN_APP_ID=your_app_id
ESIGN_APP_SECRET=your_app_secret
ESIGN_API_URL=https://openapi.esign.cn

