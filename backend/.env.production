# ==========================================
# QZT Backend 生产环境变量配置模板
# ==========================================
# 复制此文件为 .env.production 并填写实际值
#
# 部署架构：ECS 2C4G + RDS MySQL 2C2G (最大连接数 1000)

# ------------------- 环境配置 -------------------
NODE_ENV=production

# ------------------- 服务端口 -------------------
BACKEND_PORT=7890

# ------------------- MySQL 配置（拆分方式）-------------------
# 说明：database.config.ts 会自动组装 DATABASE_URL
# 密码支持特殊字符，无需手动转义
DB_HOST=your-rds-endpoint.rds.aliyuncs.com
DB_PORT=3306
DB_USERNAME=qzt_user
DB_PASSWORD=YourP@ssw0rd!#$
DB_DATABASE=qzt_prod

# ------------------- 数据库提供商 -------------------
DATABASE_PROVIDER=mysql

# ------------------- Prisma 连接池参数（可选）-------------------
# 注意：连接池参数已在 schema.prisma 中配置（connection_limit = 20）
# 如需通过 URL 覆盖，可取消下面的注释：
# DATABASE_URL="mysql://qzt_user:placeholder@host:3306/qzt_prod?connection_limit=20&pool_timeout=30"

# ------------------- Redis 配置 -------------------
# 本地 Redis 或 ECS 内网 Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ------------------- PM2 集群配置 -------------------
# 2C4G 建议启用集群模式（2 实例）
PM2_CLUSTER_ENABLED=true

# ------------------- 限流配置 -------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ------------------- 日志保留 -------------------
LOGS_RETENTION_DAYS=30

# ------------------- JWT 配置 -------------------
# 生产环境必须使用强随机密钥（至少 32 个字符）
JWT_SECRET=your-production-jwt-secret-at-least-32-chars-long-change-this
JWT_EXPIRES_IN=7d

# ------------------- 应用配置 -------------------
APP_NAME=企智通
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com

# ------------------- 2FA 配置 -------------------
TOTP_APP_NAME=企智通
# TOTP 加密密钥（用于加密存储 2FA 密钥）
TOTP_ENCRYPTION_KEY=your-32-char-encryption-key-change-this

# ------------------- e签宝配置（可选）-------------------
ESIGN_APP_ID=your_app_id
ESIGN_APP_SECRET=your_app_secret
ESIGN_API_URL=https://openapi.esign.cn
