// Prisma Schema for QZT SCRM System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 开发环境使用sqlite,生产环境改为mysql
  url      = env("DATABASE_URL")
}

// ==================== 用户和权限 ====================

model Department {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  status    Int      @default(1)
  isSystem  Boolean  @default(false) // 是否为系统部门(不可删除)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@index([parentId])
  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String
  name         String
  email        String?  @unique
  phone        String?
  avatar       String?
  departmentId String?
  status       Int      @default(1) // 1:启用 0:禁用
  isSystem     Boolean  @default(false) // 是否为系统用户(不可删除)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  followRecords FollowRecord[]
  serviceTeams  ServiceTeam[]
  customers     Customer[]      @relation("CustomerFollowUser")
  department    Department?     @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  type        String   @default("system") // 角色类型: system(系统角色), team(团队角色)
  dataScope   String   @default("all") // 数据权限范围: all(全部), department(本部门), department_and_sub(本部门及下级), custom(自定义), self(仅本人)
  dataScopeDeptIds String? // 数据权限-自定义部门ID列表(JSON数组)
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions    Permission[]      @relation("RolePermissions")
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  type        String // menu:菜单按钮 button:操作按钮 data:数据权限
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles          Role[]           @relation("RolePermissions")
  menus          Menu[]           @relation("MenuPermissions")
  rolePermissions RolePermission[]
  menuPermissions MenuPermission[]

  @@map("permissions")
}

model Menu {
  id        String   @id @default(cuid())
  path      String   @unique // 路由路径
  name      String   // 菜单名称
  icon      String?  // 图标
  parentId  String?  // 父级菜单ID
  sort      Int      @default(0) // 排序
  enabled   Boolean  @default(true) // 是否启用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         Menu?             @relation("MenuHierarchy", fields: [parentId], references: [id])
  children       Menu[]            @relation("MenuHierarchy")
  permissions    Permission[]      @relation("MenuPermissions")
  menuPermissions MenuPermission[]

  @@index([parentId])
  @@map("menus")
}

model MenuPermission {
  id           String   @id @default(cuid())
  menuId       String
  permissionId String
  createdAt    DateTime @default(now())

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([menuId, permissionId])
  @@index([menuId])
  @@map("menu_permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== 客户模块 ====================
// 概念说明：
// - Customer（客户）= 公司/企业，只有签约付款的才是正式客户
// - Contact（联系人）= 个人，独立存在，初期添加的都是联系人
// - CustomerContact（客户联系人关联）= 多对多关系，一个联系人可关联多个公司

model Contact {
  id            String   @id @default(cuid())
  name          String // 联系人姓名
  phone         String   @unique // 联系电话（唯一，便于识别）
  email         String? // 联系邮箱
  wechat        String? // 微信号
  position      String? // 职位
  department    String? // 部门
  avatar        String? // 头像
  birthdate     DateTime? // 生日
  tags          String? // 标签(JSON数组)
  remark        String? // 备注
  status        Int      @default(1) // 1:启用 0:禁用
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerContacts CustomerContact[]
  followRecords   FollowRecord[]

  @@index([phone])
  @@index([status])
  @@map("contacts")
}

model Customer {
  id            String   @id @default(cuid())
  name          String // 公司名称（必填）
  shortName     String? // 公司简称
  code          String? @unique // 公司编码（外部系统对接用）
  industry      String? // 行业
  scale         String? // 公司规模: 1-10人, 11-50人, 51-200人, 201-500人, 500人以上
  address       String? // 公司地址
  website       String? // 公司网站
  customerLevel Int      @default(0) // 0:线索公司 1:意向客户 2:正式客户 3:VIP客户
  sourceChannel String? // 来源渠道
  followUserId  String? // 跟进人ID
  tags          String? // 标签(JSON数组)
  remark        String? // 备注
  status        Int      @default(1) // 1:启用 0:禁用
  firstContactDate DateTime? // 首次联系时间
  contractDate     DateTime? // 签约时间（成为正式客户的时间）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts           Contract[]
  followRecords       FollowRecord[]
  invoices            Invoice[]
  serviceTeams        ServiceTeam[]
  assignmentHistories CustomerAssignmentHistory[]
  contacts            CustomerContact[]
  followUser          User?      @relation("CustomerFollowUser", fields: [followUserId], references: [id])

  @@index([followUserId])
  @@index([customerLevel])
  @@index([status])
  @@index([contractDate])
  @@map("customers")
}

// 客户-联系人 多对多关联表
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String // 公司ID
  contactId  String // 联系人ID
  isPrimary  Boolean  @default(false) // 是否主要联系人
  isDecision Boolean  @default(false) // 是否决策人
  department String? // 在该公司的部门
  position   String? // 在该公司的职位
  relation   String? // 与公司关系（如：法人、股东、采购负责人等）
  tags       String? // 标签(JSON数组)
  remark     String? // 备注
  status     Int      @default(1) // 1:在职 0:已离职
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([customerId, contactId])
  @@index([customerId])
  @@index([contactId])
  @@map("customer_contacts")
}

model CustomerAssignmentHistory {
  id                  String   @id @default(cuid())
  customerId          String
  previousFollowUserId String?
  newFollowUserId     String
  assignedBy          String // 操作人ID
  reason              String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([newFollowUserId])
  @@index([assignedBy])
  @@map("customer_assignment_histories")
}

// ==================== 跟进记录 ====================

model FollowRecord {
  id         String    @id @default(cuid())
  customerId String // 公司ID
  contactId  String? // 联系人ID（可选，针对具体联系人的跟进）
  userId     String
  type       Int // 跟进类型: 1:电话 2:微信 3:上门 4:邮件 5:其他
  content    String // 跟进内容
  nextTime   DateTime? // 下次跟进时间
  images     String? // 图片(JSON数组)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([contactId])
  @@index([userId])
  @@map("follow_records")
}

// ==================== 产品模块 ====================

model Product {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  description    String?
  price          Float    // 基础价格
  pricingType    String   @default("FIXED") // FIXED:固定价格 TIER_AMOUNT:按金额阶梯 TIER_COUNT:按次数计费 ZERO_DECLARATION:零申报
  invoiceLimit   Float    @default(0) // 开票额度(月)
  invoiceCount   Int      @default(0) // 套餐包含开票张数(月)
  overLimitPrice Float    @default(0) // 超额单价
  serviceRoleId  String?  // 服务负责人角色ID（哪个角色负责此产品的运维）
  packageId      String?  // 所属套餐ID
  status         Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts      Contract[]
  flows          ProductFlow[]
  pricingRules   PricingRule[]
  package        ProductPackage?  @relation("PackageProducts", fields: [packageId], references: [id])
  packageItems   ProductPackage[] @relation("PackageItems")

  @@map("products")
}

// 产品套餐
model ProductPackage {
  id          String   @id @default(cuid())
  name        String   // 套餐名称
  code        String   @unique // 套餐编码
  description String?  // 套餐描述
  discount    Float    @default(0) // 套餐折扣（0-1）
  duration    Int?     // 套餐时长（月）
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[] @relation("PackageItems")
  packageItems Product[] @relation("PackageProducts")

  @@map("product_packages")
}

// ==================== 阶梯定价规则 ====================

model PricingRule {
  id             String   @id @default(cuid())
  productId      String
  name           String   // 规则名称
  ruleType       String   // AMOUNT_TIER:按金额阶梯 COUNT_TIER:按次数 ZERO_DECLARATION:零申报
  effectiveDate  DateTime @default(now()) // 生效日期
  expiryDate     DateTime? // 失效日期
  status         Int      @default(1) // 1:启用 0:禁用
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers   PricingTier[]

  @@index([productId])
  @@map("pricing_rules")
}

model PricingTier {
  id              String   @id @default(cuid())
  pricingRuleId   String
  minThreshold    Float    // 最小阈值
  maxThreshold    Float?   // 最大阈值(null表示无上限)
  price           Float    // 该阶梯的价格
  additionalPrice Float?   // 超出基础价格的加价部分
  description     String?  // 描述
  order           Int      // 排序
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricingRule PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@index([pricingRuleId])
  @@map("pricing_tiers")
}

// ==================== 产品流程 ====================

model ProductFlow {
  id        String   @id @default(cuid())
  productId String
  name      String // 流程名称
  type      String // NODE:一次性节点流程 CYCLE:周期性流程
  config    String // 流程配置(JSON)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nodes     ProductFlowNode[]

  @@map("product_flows")
}

// 产品流程节点
model ProductFlowNode {
  id          String   @id @default(cuid())
  flowId      String   // 流程ID
  name        String   // 节点名称
  type        String   // 节点类型: TASK(任务), NOTIFY(通知), APPROVE(审批)
  roleId      String?  // 负责人角色ID
  order       Int      // 执行顺序
  config      String?  // 节点配置(JSON)
  notifyConfig String? // 通知配置(JSON): 发送给谁、通知内容等
  cycleConfig String? // 周期配置(JSON): 仅周期性节点使用，包含cron表达式
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flow        ProductFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  executions  ProductFlowExecution[]

  @@index([flowId])
  @@map("product_flow_nodes")
}

// 产品流程执行记录
model ProductFlowExecution {
  id          String   @id @default(cuid())
  nodeId      String   // 节点ID
  contractId  String?  // 关联合同ID（可选）
  customerId  String?  // 关联客户ID
  status      String   // 状态: PENDING(待执行), RUNNING(执行中), SUCCESS(成功), FAILED(失败), SKIPPED(跳过)
  result      String?  // 执行结果(JSON)
  error       String?  // 错误信息
  executedAt  DateTime? // 实际执行时间
  completedAt DateTime? // 完成时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node        ProductFlowNode @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@index([contractId])
  @@index([status])
  @@map("product_flow_executions")
}

// ==================== 合同模块 ====================

model ContractTemplate {
  id          String   @id @default(cuid())
  name        String   // 模板名称
  code        String   @unique // 模板编码
  content     String   // 合同内容（支持变量占位符）
  variables   String?  // 变量定义(JSON数组)
  description String?  // 模板说明
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts   Contract[]

  @@map("contract_templates")
}

model Contract {
  id           String   @id @default(cuid())
  contractNo   String   @unique
  customerId   String
  productId    String
  templateId   String? // 合同模板ID
  amount       Float
  paidAmount   Float    @default(0)
  status       Int      @default(0) // 0:待收款 1:部分收款 2:已收全
  serviceStart DateTime
  serviceEnd   DateTime
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  template        ContractTemplate? @relation(fields: [templateId], references: [id])
  payments        Payment[]

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

// ==================== 收款模块 ====================

model Payment {
  id         String    @id @default(cuid())
  contractId String
  amount     Float
  method     String // 收款方式: 1:银行转账 2:微信 3:支付宝 4:现金
  voucherUrl String? // 凭证URL
  payTime    DateTime? // 付款时间
  status     Int       @default(0) // 0:待确认 1:已确认
  remark     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("payments")
}

// ==================== 开票记录 ====================

model Invoice {
  id          String   @id @default(cuid())
  customerId  String
  contractId  String? // 关联合同(可选)
  amount      Float
  count       Int // 开票张数
  month       String // 开票月份(YYYY-MM)
  isOverLimit Boolean  @default(false) // 是否超额
  overAmount  Float? // 超额金额
  overCount   Int      @default(0) // 超额张数
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceChangeRecords  InvoicePriceChange[]

  @@index([customerId, month])
  @@map("invoices")
}

// ==================== 发票价格变更记录 ====================

model InvoicePriceChange {
  id           String   @id @default(cuid())
  invoiceId    String
  oldPrice     Float    // 原价格
  newPrice     Float    // 新价格
  changeReason String?  // 变更原因
  changedBy    String?  // 操作人ID
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_price_changes")
}

// ==================== 服务团队 ====================

model ServiceTeam {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  roleCode   String // 角色代码: SALE,FINANCE,OUTWORK
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([customerId, userId, roleCode])
  @@index([userId])
  @@map("service_teams")
}

// ==================== 自动化规则引擎 ====================

model Trigger {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique
  type       String // DATA_ADD, DATA_UPDATE, TIME_CONDITION, SCHEDULED
  entityType String // CUSTOMER, CONTRACT, etc.
  enabled    Boolean     @default(true)
  conditions Condition[]
  workflows  Workflow[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([entityType])
  @@map("triggers")
}

model Condition {
  id        String  @id @default(cuid())
  triggerId String
  field     String // 字段名
  operator  String // =, !=, >, <, >=, <=, IN, LIKE, BETWEEN
  value     String // 比较值(JSON)
  logic     String  @default("AND") // AND, OR
  parentId  String? // 父条件ID(支持树形结构)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trigger   Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@map("conditions")
}

model Workflow {
  id         String  @id @default(cuid())
  triggerId  String
  actionType String // RECORD_ADD, RECORD_UPDATE, MESSAGE, CUSTOM
  config     String // 动作配置(JSON)
  order      Int // 执行顺序
  enabled    Boolean @default(true)
  trigger    Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@map("workflows")
}

model Log {
  id         String   @id @default(cuid())
  triggerId  String
  entityType String?
  entityId   String?
  status     String // SUCCESS, FAILED, PARTIAL
  duration   Int? // 执行时长(ms)
  error      String?
  createdAt  DateTime @default(now())

  details LogDetail[]

  @@index([triggerId, createdAt])
  @@map("logs")
}

model LogDetail {
  id         String   @id @default(cuid())
  logId      String
  workflowId String
  actionType String
  config     String
  status     String
  result     String?
  error      String?
  createdAt  DateTime @default(now())

  log Log @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@map("log_details")
}

// ==================== 自动化任务系统 ====================

model AutomationRule {
  id          String   @id @default(cuid())
  name        String   // 规则名称
  type        String   // CONTRACT_EXPIRY:合同到期 NEW_CUSTOMER_FOLLOW:新客户跟进 MONTHLY_TASK:月度待办 CUSTOMER_ACTIVATION:客户激活
  enabled     Boolean  @default(true)
  config      String?  // 配置(JSON) - 可选
  cronExpression String? // Cron表达式
  lastExecutedAt DateTime? // 最后执行时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks AutomationTask[]

  @@map("automation_rules")
}

model AutomationTask {
  id         String   @id @default(cuid())
  ruleId     String
  status     String   // PENDING:待执行 SUCCESS:成功 FAILED:失败
  result     String?  // 执行结果(JSON)
  error      String?  // 错误信息
  executedAt DateTime @default(now())
  duration   Int?     // 执行时长(ms)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@map("automation_tasks")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收用户ID
  type      String   // 类型: CONTRACT_EXPIRY, FOLLOW_UP, TASK, etc.
  title     String   // 标题
  content   String   // 内容
  link      String?  // 跳转链接
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== 系统配置 ====================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique // 配置键
  value       String   // 配置值(JSON字符串)
  category    String   // 配置分类: basic, email, sms, wechat, etc.
  description String?  // 配置说明
  isPublic    Boolean  @default(false) // 是否公开（前端可访问）
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // 最后更新人ID

  @@index([category])
  @@map("system_configs")
}

model CommonPhrase {
  id         String   @id @default(cuid())
  userId     String?  // null表示系统常用语
  content    String   // 常用语内容
  category   String?  // 分类: GREETING, FOLLOW_UP, CLOSING, OTHER
  useCount   Int      @default(0) // 使用次数
  isSystem   Boolean  @default(false) // 是否系统预置
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@map("common_phrases")
}

model PaymentAccount {
  id         String   @id @default(cuid())
  name       String   // 账户名称
  accountNo  String   // 账号
  bank       String?  // 开户行
  type       String   // 类型: 1:银行转账 2:微信 3:支付宝 4:现金
  isDefault  Boolean  @default(false) // 是否默认账户
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_accounts")
}

// ==================== 日志管理 ====================

model LoginLog {
  id         String   @id @default(cuid())
  userId     String
  username   String
  email      String?
  ip         String?
  userAgent  String?
  browser    String?  // 浏览器信息
  os         String?  // 操作系统
  status     String   // SUCCESS, FAILED
  failReason String?  // 失败原因
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("login_logs")
}

model OperationLog {
  id         String   @id @default(cuid())
  userId     String
  username   String
  action     String   // 操作类型: CREATE, UPDATE, DELETE, EXPORT, etc.
  resource   String   // 资源类型: User, Customer, Contract, etc.
  resourceId String?  // 资源ID
  ip         String?
  userAgent  String?
  detail     String?  // 详细信息(JSON)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("operation_logs")
}

model SystemLog {
  id         String   @id @default(cuid())
  level      String   // INFO, WARN, ERROR, DEBUG
  module     String   // 模块名
  message    String   // 日志消息
  stacktrace String?  // 堆栈信息
  detail     String?  // 详细信息(JSON)
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@map("system_logs")
}

// ==================== Webhook 消息管理 ====================

model WebhookConfig {
  id         String   @id @default(cuid())
  name       String   // 配置名称
  platform   String   // 平台: wecom(企业微信), feishu(飞书), dingtalk(钉钉)
  webhookUrl String   // Webhook URL
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   WebhookMessage[]

  @@index([platform])
  @@map("webhook_configs")
}

model WebhookMessage {
  id          String   @id @default(cuid())
  configId    String
  platform    String   // 平台
  messageType String   // 消息类型: text, markdown, card
  content     String   // 消息内容(JSON)
  status      String   // success, failed
  response    String?  // 响应内容
  error       String?  // 错误信息
  sentAt      DateTime @default(now())

  config WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
  @@index([sentAt])
  @@map("webhook_messages")
}

// ==================== OSS 文件管理 ====================

model OssFile {
  id          String   @id @default(cuid())
  fileName    String   // 原始文件名
  fileUrl     String   // 文件URL
  fileSize    Int      // 文件大小(字节)
  fileType    String   // 文件类型: image, document, video, other
  mimeType    String   // MIME类型
  uploaderId  String?  // 上传者ID
  createdAt   DateTime @default(now())

  videoPosts  SocialMediaPost[] @relation("SocialMediaPostVideo")
  coverPosts  SocialMediaPost[] @relation("SocialMediaPostCover")

  @@index([uploaderId])
  @@index([fileType])
  @@index([createdAt])
  @@map("oss_files")
}

// ==================== 新媒体管理 ====================

// 新媒体账号配置
model SocialMediaAccount {
  id          String   @id @default(cuid())
  platform    String   // douyin, xiaohongshu, wechat
  accountName String   // 账号名称
  accountId   String?  // 平台账号ID
  appId       String?  // 应用ID
  appSecret   String?  // 应用密钥(加密存储)
  accessToken String?  // 访问令牌(加密存储)
  refreshToken String? // 刷新令牌(加密存储)
  openId      String?  // 开放ID
  unionId     String?  // 联合ID(主要用于微信)
  expiresAt   DateTime? // 令牌过期时间
  status      Int      @default(1) // 1:启用 0:禁用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       SocialMediaPost[]

  @@index([platform])
  @@index([status])
  @@map("social_media_accounts")
}

// 新媒体内容
model SocialMediaPost {
  id           String   @id @default(cuid())
  accountId    String   // 关联账号ID
  title        String   // 标题
  content      String?  // 文案内容
  videoFile    OssFile? @relation("SocialMediaPostVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  videoFileId  String?  // 视频文件ID(关联oss_files)
  coverFile    OssFile? @relation("SocialMediaPostCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  coverFileId  String?  // 封面图文件ID(关联oss_files)
  videoUrl     String?  // 视频URL
  coverUrl     String?  // 封面图URL
  topics       String?  // 话题标签(JSON数组)
  location     String?  // 位置信息
  visibility   String   @default("public") // public, friends, private
  scheduledAt  DateTime? // 定时发布时间
  status       String   @default("draft") // draft:草稿, scheduled:定时中, publishing:发布中, published:已发布, failed:失败
  publishData  String?  // 各平台发布数据(JSON)
  error        String?  // 错误信息
  publishedAt  DateTime? // 实际发布时间
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      SocialMediaAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("social_media_posts")
}

// 新媒体发布记录（支持多平台同时发布）
model SocialMediaPublishLog {
  id         String   @id @default(cuid())
  postId     String   // 关联内容ID
  platform   String   // 目标平台: douyin, xiaohongshu, wechat
  accountId  String   // 使用的账号ID
  status     String   @default("pending") // pending:待发布, publishing:发布中, success:成功, failed:失败
  postIdOnPlatform String? // 平台返回的内容ID
  postUrl    String?  // 平台内容链接
  error      String?  // 错误信息
  retryCount Int      @default(0) // 重试次数
  publishedAt DateTime? // 发布时间
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([postId])
  @@index([platform])
  @@index([status])
  @@map("social_media_publish_logs")
}

// ==================== 支付订单 ====================

// 支付订单（独立于收款记录，用于在线支付）
model PaymentOrder {
  id              String   @id @default(cuid())
  contractId      String?  // 关联合同ID（可选）
  orderNo         String   @unique // 订单号
  amount          Float    // 支付金额
  paymentMethod   String   // 支付方式: wechat, alipay, bank
  paymentChannel  String?  // 支付渠道: wechat_pay, alipay_sign, bank_transfer
  status          String   @default("pending") // pending:待支付, paid:已支付, cancelled:已取消, refunded:已退款, expired:已过期
  qrCodeUrl       String?  // 二维码URL
  qrCodeData      String?  // 二维码数据（用于生成）
  transactionId   String?  // 第三方交易ID
  prepayId        String?  // 预支付ID（微信）
  outTradeNo      String?  // 商户订单号
  paidAt          DateTime? // 支付时间
  expiredAt       DateTime? // 过期时间
  clientIp        String?  // 客户端IP
  returnUrl       String?  // 支付完成跳转URL
  notifyUrl       String?  // 异步通知URL
  body            String?  // 订单描述
  attach          String?  // 附加数据
  error           String?  // 错误信息
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联收款记录（支付成功后创建）
  paymentId       String?

  @@index([contractId])
  @@index([orderNo])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payment_orders")
}

// 支付配置（扩展PaymentAccount）
model PaymentConfig {
  id              String   @id @default(cuid())
  paymentMethod   String   // 支付方式: wechat, alipay
  paymentChannel  String   // 支付渠道
  appId           String?  // 应用ID
  appSecret       String?  // 应用密钥(加密存储)
  merchantId      String?  // 商户ID
  apiKey          String?  // API密钥(加密存储)
  certPath        String?  // 证书路径
  notifyUrl       String?  // 默认回调地址
  returnUrl       String?  // 默认返回地址
  sandbox         Boolean  @default(false) // 是否沙箱环境
  status          Int      @default(1) // 1:启用 0:禁用
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentMethod])
  @@index([status])
  @@map("payment_configs")
}

// 支付回调日志
model PaymentCallbackLog {
  id          String   @id @default(cuid())
  orderId     String   // 支付订单ID
  paymentMethod String // 支付方式
  status      String   // success, failed, pending
  rawData     String   // 原始回调数据(JSON)
  responseData String? // 响应数据
  error       String?  // 错误信息
  ip          String?  // 回调来源IP
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("payment_callback_logs")
}

