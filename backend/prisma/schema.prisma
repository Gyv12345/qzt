// Prisma Schema for QZT SCRM System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 开发环境使用sqlite,生产环境改为mysql
  url      = env("DATABASE_URL")
}

// ==================== 用户和权限 ====================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  email     String?  @unique
  phone     String?
  avatar    String?
  status    Int      @default(1) // 1:启用 0:禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  followRecords FollowRecord[]
  serviceTeams  ServiceTeam[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  type        String // menu:菜单按钮 button:操作按钮 data:数据权限
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== 客户模块 ====================

model Customer {
  id            String   @id @default(cuid())
  name          String // 客户名称
  contactName   String // 联系人
  contactPhone  String // 联系电话
  contactEmail  String? // 联系邮箱
  companyName   String? // 公司名称
  address       String? // 地址
  customerLevel Int      @default(0) // 0:潜在 1:意向 2:正式 3:VIP
  sourceChannel Int? // 来源渠道
  followUserId  String? // 跟进人ID
  tags          String? // 标签(JSON数组)
  remark        String? // 备注
  status        Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts           Contract[]
  followRecords       FollowRecord[]
  invoices            Invoice[]
  serviceTeams        ServiceTeam[]
  assignmentHistories CustomerAssignmentHistory[]

  @@index([followUserId])
  @@index([customerLevel])
  @@index([status])
  @@map("customers")
}

model CustomerAssignmentHistory {
  id                  String   @id @default(cuid())
  customerId          String
  previousFollowUserId String?
  newFollowUserId     String
  assignedBy          String // 操作人ID
  reason              String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([newFollowUserId])
  @@index([assignedBy])
  @@map("customer_assignment_histories")
}

// ==================== 跟进记录 ====================

model FollowRecord {
  id         String    @id @default(cuid())
  customerId String
  userId     String
  type       Int // 跟进类型: 1:电话 2:微信 3:上门 4:邮件 5:其他
  content    String // 跟进内容
  nextTime   DateTime? // 下次跟进时间
  images     String? // 图片(JSON数组)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@map("follow_records")
}

// ==================== 产品模块 ====================

model Product {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  description    String?
  price          Float    // 基础价格
  pricingType    String   @default("FIXED") // FIXED:固定价格 TIER_AMOUNT:按金额阶梯 TIER_COUNT:按次数计费 ZERO_DECLARATION:零申报
  invoiceLimit   Float    @default(0) // 开票额度(月)
  invoiceCount   Int      @default(0) // 套餐包含开票张数(月)
  overLimitPrice Float    @default(0) // 超额单价
  status         Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts    Contract[]
  flows        ProductFlow[]
  pricingRules PricingRule[]

  @@map("products")
}

// ==================== 阶梯定价规则 ====================

model PricingRule {
  id             String   @id @default(cuid())
  productId      String
  name           String   // 规则名称
  ruleType       String   // AMOUNT_TIER:按金额阶梯 COUNT_TIER:按次数 ZERO_DECLARATION:零申报
  effectiveDate  DateTime @default(now()) // 生效日期
  expiryDate     DateTime? // 失效日期
  status         Int      @default(1) // 1:启用 0:禁用
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers   PricingTier[]

  @@index([productId])
  @@map("pricing_rules")
}

model PricingTier {
  id              String   @id @default(cuid())
  pricingRuleId   String
  minThreshold    Float    // 最小阈值
  maxThreshold    Float?   // 最大阈值(null表示无上限)
  price           Float    // 该阶梯的价格
  additionalPrice Float?   // 超出基础价格的加价部分
  description     String?  // 描述
  order           Int      // 排序
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricingRule PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@index([pricingRuleId])
  @@map("pricing_tiers")
}

// ==================== 产品流程 ====================

model ProductFlow {
  id        String   @id @default(cuid())
  productId String
  name      String // 流程名称
  type      String // NODE:节点流程 CYCLE:周期流程
  config    String // 流程配置(JSON)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_flows")
}

// ==================== 合同模块 ====================

model Contract {
  id           String   @id @default(cuid())
  contractNo   String   @unique
  customerId   String
  productId    String
  amount       Float
  paidAmount   Float    @default(0)
  status       Int      @default(0) // 0:待收款 1:部分收款 2:已收全
  serviceStart DateTime
  serviceEnd   DateTime
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

// ==================== 收款模块 ====================

model Payment {
  id         String    @id @default(cuid())
  contractId String
  amount     Float
  method     String // 收款方式: 1:银行转账 2:微信 3:支付宝 4:现金
  voucherUrl String? // 凭证URL
  payTime    DateTime? // 付款时间
  status     Int       @default(0) // 0:待确认 1:已确认
  remark     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("payments")
}

// ==================== 开票记录 ====================

model Invoice {
  id          String   @id @default(cuid())
  customerId  String
  contractId  String? // 关联合同(可选)
  amount      Float
  count       Int // 开票张数
  month       String // 开票月份(YYYY-MM)
  isOverLimit Boolean  @default(false) // 是否超额
  overAmount  Float? // 超额金额
  overCount   Int      @default(0) // 超额张数
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceChangeRecords  InvoicePriceChange[]

  @@index([customerId, month])
  @@map("invoices")
}

// ==================== 发票价格变更记录 ====================

model InvoicePriceChange {
  id           String   @id @default(cuid())
  invoiceId    String
  oldPrice     Float    // 原价格
  newPrice     Float    // 新价格
  changeReason String?  // 变更原因
  changedBy    String?  // 操作人ID
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_price_changes")
}

// ==================== 服务团队 ====================

model ServiceTeam {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  roleCode   String // 角色代码: SALE,FINANCE,OUTWORK
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([customerId, userId, roleCode])
  @@index([userId])
  @@map("service_teams")
}

// ==================== 自动化规则引擎 ====================

model Trigger {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique
  type       String // DATA_ADD, DATA_UPDATE, TIME_CONDITION, SCHEDULED
  entityType String // CUSTOMER, CONTRACT, etc.
  enabled    Boolean     @default(true)
  conditions Condition[]
  workflows  Workflow[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([entityType])
  @@map("triggers")
}

model Condition {
  id        String  @id @default(cuid())
  triggerId String
  field     String // 字段名
  operator  String // =, !=, >, <, >=, <=, IN, LIKE, BETWEEN
  value     String // 比较值(JSON)
  logic     String  @default("AND") // AND, OR
  parentId  String? // 父条件ID(支持树形结构)
  trigger   Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@map("conditions")
}

model Workflow {
  id         String  @id @default(cuid())
  triggerId  String
  actionType String // RECORD_ADD, RECORD_UPDATE, MESSAGE, CUSTOM
  config     String // 动作配置(JSON)
  order      Int // 执行顺序
  enabled    Boolean @default(true)
  trigger    Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@map("workflows")
}

model Log {
  id         String   @id @default(cuid())
  triggerId  String
  entityType String?
  entityId   String?
  status     String // SUCCESS, FAILED, PARTIAL
  duration   Int? // 执行时长(ms)
  error      String?
  createdAt  DateTime @default(now())

  details LogDetail[]

  @@index([triggerId, createdAt])
  @@map("logs")
}

model LogDetail {
  id         String   @id @default(cuid())
  logId      String
  workflowId String
  actionType String
  config     String
  status     String
  result     String?
  error      String?
  createdAt  DateTime @default(now())

  log Log @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@map("log_details")
}

// ==================== 自动化任务系统 ====================

model AutomationRule {
  id          String   @id @default(cuid())
  name        String   // 规则名称
  type        String   // CONTRACT_EXPIRY:合同到期 NEW_CUSTOMER_FOLLOW:新客户跟进 MONTHLY_TASK:月度待办 CUSTOMER_ACTIVATION:客户激活
  enabled     Boolean  @default(true)
  config      String   // 配置(JSON)
  cronExpression String? // Cron表达式
  lastExecutedAt DateTime? // 最后执行时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks AutomationTask[]

  @@map("automation_rules")
}

model AutomationTask {
  id         String   @id @default(cuid())
  ruleId     String
  status     String   // PENDING:待执行 SUCCESS:成功 FAILED:失败
  result     String?  // 执行结果(JSON)
  error      String?  // 错误信息
  executedAt DateTime @default(now())
  duration   Int?     // 执行时长(ms)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@map("automation_tasks")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收用户ID
  type      String   // 类型: CONTRACT_EXPIRY, FOLLOW_UP, TASK, etc.
  title     String   // 标题
  content   String   // 内容
  link      String?  // 跳转链接
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== 系统配置 ====================

model CommonPhrase {
  id         String   @id @default(cuid())
  userId     String?  // null表示系统常用语
  content    String   // 常用语内容
  category   String?  // 分类: GREETING, FOLLOW_UP, CLOSING, OTHER
  useCount   Int      @default(0) // 使用次数
  isSystem   Boolean  @default(false) // 是否系统预置
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@map("common_phrases")
}

model PaymentAccount {
  id         String   @id @default(cuid())
  name       String   // 账户名称
  accountNo  String   // 账号
  bank       String?  // 开户行
  type       String   // 类型: 1:银行转账 2:微信 3:支付宝 4:现金
  isDefault  Boolean  @default(false) // 是否默认账户
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_accounts")
}

