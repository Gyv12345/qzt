# ============================================================
# Nginx 日志轮转配置
# 安装: cp config/logrotate/nginx /etc/logrotate.d/nginx-custom
# ============================================================

/var/log/nginx/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    dateext
    dateformat -%Y%m%d

    prerotate
        if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
            run-parts /etc/logrotate.d/httpd-prerotate; \
        fi
    endscript

    postrotate
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
