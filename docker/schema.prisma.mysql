// Prisma Schema for QZT SCRM System - MySQL Production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户和权限 ====================

model Department {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  parentId  String?
  sort      Int      @default(0)
  status    String   @default("ACTIVE") @db.VarChar(20)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@index([parentId])
  @@map("departments")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(50)
  password     String   @db.VarChar(255)
  name         String   @db.VarChar(100)
  email        String?  @unique @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  avatar       String?  @db.Text
  departmentId String?
  status       String   @default("ACTIVE") @db.VarChar(20)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?   @db.VarChar(255)
  twoFactorBackupCodes String?  @db.Text
  twoFactorSetupCompletedAt DateTime?
  hasCompletedFirstLogin Boolean @default(false)

  roles         UserRole[]
  followRecords FollowRecord[]
  serviceTeams  ServiceTeam[]
  customers     Customer[]      @relation("CustomerFollowUser")
  ownedContacts Contact[]       @relation("ContactOwner")
  department    Department?     @relation(fields: [departmentId], references: [id])
  cmsAuthoredContents CmsContent[] @relation("CmsContentAuthor")
  cmsProfiles  CmsContent[]     @relation("CmsUserProfile")

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  type        String   @default("system") @db.VarChar(20)
  dataScope   String   @default("all") @db.VarChar(50)
  dataScopeDeptIds String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions    Permission[]      @relation("RolePermissions")
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(36)
  roleId    String   @db.VarChar(36)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  type        String   @db.VarChar(50)
  parentId    String?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Permission?      @relation("PermissionHierarchy", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionHierarchy")
  roles          Role[]           @relation("RolePermissions")
  menus          Menu[]           @relation("MenuPermissions")
  rolePermissions RolePermission[]
  menuPermissions MenuPermission[]

  @@index([parentId])
  @@map("permissions")
}

model Menu {
  id        String   @id @default(uuid())
  path      String   @unique @db.VarChar(200)
  name      String   @db.VarChar(100)
  icon      String?  @db.VarChar(100)
  parentId  String?
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         Menu?             @relation("MenuHierarchy", fields: [parentId], references: [id])
  children       Menu[]            @relation("MenuHierarchy")
  permissions    Permission[]      @relation("MenuPermissions")
  menuPermissions MenuPermission[]

  @@index([parentId])
  @@map("menus")
}

model MenuPermission {
  id           String   @id @default(uuid())
  menuId       String   @db.VarChar(36)
  permissionId String   @db.VarChar(36)
  createdAt    DateTime @default(now())

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([menuId, permissionId])
  @@index([menuId])
  @@map("menu_permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @db.VarChar(36)
  permissionId String   @db.VarChar(36)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== 客户模块 ====================

model Contact {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  phone         String   @unique @db.VarChar(20)
  email         String?  @db.VarChar(100)
  wechat        String?  @db.VarChar(100)
  position      String?  @db.VarChar(100)
  department    String?  @db.VarChar(100)
  avatar        String?  @db.Text
  birthdate     DateTime?
  tags          String?  @db.Text
  remark        String?  @db.Text
  ownerUserId   String?
  status        String   @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerContacts CustomerContact[]
  followRecords   FollowRecord[]
  ownerUser       User?     @relation("ContactOwner", fields: [ownerUserId], references: [id])

  @@index([phone])
  @@index([ownerUserId])
  @@index([status])
  @@map("contacts")
}

model Customer {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(200)
  shortName     String?  @db.VarChar(100)
  code          String?  @unique @db.VarChar(50)
  industry      String?  @db.VarChar(100)
  scale         String?  @db.VarChar(50)
  address       String?  @db.Text
  website       String?  @db.VarChar(200)
  customerLevel String   @default("LEAD") @db.VarChar(20)
  sourceChannel String?  @db.VarChar(100)
  followUserId  String?
  tags          String?  @db.Text
  remark        String?  @db.Text
  status        Int      @default(1)
  firstContactDate DateTime?
  contractDate     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts           Contract[]
  followRecords       FollowRecord[]
  invoices            Invoice[]
  serviceTeams        ServiceTeam[]
  assignmentHistories CustomerAssignmentHistory[]
  contacts            CustomerContact[]
  followUser          User?      @relation("CustomerFollowUser", fields: [followUserId], references: [id])

  @@index([followUserId])
  @@index([customerLevel])
  @@index([status])
  @@index([contractDate])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String   @db.VarChar(36)
  contactId  String   @db.VarChar(36)
  isPrimary  Boolean  @default(false)
  isDecision Boolean  @default(false)
  department String?  @db.VarChar(100)
  position   String?  @db.VarChar(100)
  relation   String?  @db.VarChar(100)
  tags       String?  @db.Text
  remark     String?  @db.Text
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([customerId, contactId])
  @@index([customerId])
  @@index([contactId])
  @@map("customer_contacts")
}

model CustomerAssignmentHistory {
  id                  String   @id @default(uuid())
  customerId          String   @db.VarChar(36)
  previousFollowUserId String?
  newFollowUserId     String   @db.VarChar(36)
  assignedBy          String   @db.VarChar(36)
  reason              String?  @db.Text
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([newFollowUserId])
  @@index([assignedBy])
  @@map("customer_assignment_histories")
}

// ==================== 跟进记录 ====================

model FollowRecord {
  id         String    @id @default(uuid())
  customerId String    @db.VarChar(36)
  contactId  String?
  userId     String    @db.VarChar(36)
  type       Int
  content    String    @db.Text
  nextTime   DateTime?
  images     String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([contactId])
  @@index([userId])
  @@map("follow_records")
}

// ==================== 产品模块 ====================

model Product {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(200)
  code           String   @unique @db.VarChar(50)
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  pricingType    String   @default("FIXED") @db.VarChar(50)
  timeline       String?  @db.Text
  serviceRoleId  String?
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contractItems  ContractItem[]
  pricingRules   PricingRule[]
  cmsShowcases   CmsContent[]    @relation("CmsProductShowcase")

  @@map("products")
}

// ==================== 阶梯定价规则 ====================

model PricingRule {
  id             String   @id @default(uuid())
  productId      String   @db.VarChar(36)
  name           String   @db.VarChar(100)
  ruleType       String   @db.VarChar(50)
  effectiveDate  DateTime @default(now())
  expiryDate     DateTime?
  status         Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers   PricingTier[]

  @@index([productId])
  @@map("pricing_rules")
}

model PricingTier {
  id              String   @id @default(uuid())
  pricingRuleId   String   @db.VarChar(36)
  minThreshold    Decimal  @db.Decimal(10, 2)
  maxThreshold    Decimal?
  price           Decimal  @db.Decimal(10, 2)
  additionalPrice Decimal? @db.Decimal(10, 2)
  description     String?  @db.Text
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricingRule PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@index([pricingRuleId])
  @@map("pricing_tiers")
}

// ==================== 合同模块 ====================

model ContractTemplate {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(50)
  content     String   @db.LongText
  variables   String?  @db.Text
  description String?  @db.Text
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts   Contract[]

  @@map("contract_templates")
}

model Contract {
  id           String   @id @default(uuid())
  contractNo   String   @unique @db.VarChar(50)
  customerId   String   @db.VarChar(36)
  templateId   String?
  originalAmount Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("UNPAID") @db.VarChar(20)
  serviceStart  DateTime
  serviceEnd    DateTime
  remark        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer        Customer        @relation(fields: [customerId], references: [id])
  template        ContractTemplate? @relation(fields: [templateId], references: [id])
  payments        Payment[]
  items           ContractItem[]

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

model ContractItem {
  id            String   @id @default(uuid())
  contractId    String   @db.VarChar(36)
  productId     String   @db.VarChar(36)
  quantity      Int      @default(1)
  originalPrice Decimal  @db.Decimal(10, 2)
  actualPrice   Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([contractId])
  @@index([productId])
  @@map("contract_items")
}

// ==================== 收款模块 ====================

model Payment {
  id         String    @id @default(uuid())
  contractId String    @db.VarChar(36)
  amount     Decimal   @db.Decimal(12, 2)
  method     String    @db.VarChar(50)
  voucherUrl String?   @db.Text
  payTime    DateTime?
  status     String    @default("PENDING") @db.VarChar(20)
  remark     String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("payments")
}

// ==================== 开票记录 ====================

model Invoice {
  id          String   @id @default(uuid())
  customerId  String   @db.VarChar(36)
  contractId  String?
  amount      Decimal  @db.Decimal(12, 2)
  count       Int
  month       String   @db.VarChar(7)
  status      String   @default("PENDING") @db.VarChar(20)
  issuedAt    DateTime?
  isOverLimit Boolean  @default(false)
  overAmount  Decimal? @db.Decimal(12, 2)
  overCount   Int      @default(0)
  remark      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceChangeRecords  InvoicePriceChange[]

  @@index([customerId, month])
  @@index([status])
  @@map("invoices")
}

model InvoicePriceChange {
  id           String   @id @default(uuid())
  invoiceId    String   @db.VarChar(36)
  oldPrice     Decimal  @db.Decimal(12, 2)
  newPrice     Decimal  @db.Decimal(12, 2)
  changeReason String?  @db.Text
  changedBy    String?
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_price_changes")
}

// ==================== 服务团队 ====================

model ServiceTeam {
  id         String   @id @default(uuid())
  customerId String   @db.VarChar(36)
  userId     String   @db.VarChar(36)
  roleCode   String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([customerId, userId, roleCode])
  @@index([userId])
  @@map("service_teams")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(36)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  content   String   @db.Text
  link      String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== 系统配置 ====================

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.LongText
  category    String   @db.VarChar(50)
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category])
  @@map("system_configs")
}

model CommonPhrase {
  id         String   @id @default(uuid())
  userId     String?
  content    String   @db.Text
  category   String?  @db.VarChar(50)
  useCount   Int      @default(0)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@map("common_phrases")
}

model PaymentAccount {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  accountNo  String   @db.VarChar(200)
  bank       String?  @db.VarChar(200)
  type       String   @db.VarChar(50)
  isDefault  Boolean  @default(false)
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_accounts")
}

// ==================== 日志管理 ====================

model LoginLog {
  id         String   @id @default(uuid())
  userId     String   @db.VarChar(36)
  username   String   @db.VarChar(100)
  email      String?  @db.VarChar(100)
  ip         String?  @db.VarChar(50)
  userAgent  String?  @db.Text
  browser    String?  @db.VarChar(100)
  os         String?  @db.VarChar(100)
  status     String   @db.VarChar(20)
  failReason String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("login_logs")
}

model OperationLog {
  id         String   @id @default(uuid())
  userId     String   @db.VarChar(36)
  username   String   @db.VarChar(100)
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(50)
  resourceId String?
  ip         String?  @db.VarChar(50)
  userAgent  String?  @db.Text
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("operation_logs")
}

model SystemLog {
  id         String   @id @default(uuid())
  level      String   @db.VarChar(20)
  module     String   @db.VarChar(100)
  message    String   @db.Text
  stacktrace String?  @db.Text
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@map("system_logs")
}

// ==================== Webhook 消息管理 ====================

model WebhookConfig {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  platform   String   @db.VarChar(50)
  webhookUrl String   @db.VarChar(500)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   WebhookMessage[]

  @@index([platform])
  @@map("webhook_configs")
}

model WebhookMessage {
  id          String   @id @default(uuid())
  configId    String   @db.VarChar(36)
  platform    String   @db.VarChar(50)
  messageType String   @db.VarChar(50)
  content     String   @db.Text
  status      String   @db.VarChar(20)
  response    String?  @db.Text
  error       String?  @db.Text
  sentAt      DateTime @default(now())

  config WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
  @@index([sentAt])
  @@map("webhook_messages")
}

// ==================== OSS 文件管理 ====================

model OssFile {
  id          String   @id @default(uuid())
  fileName    String   @db.VarChar(255)
  fileUrl     String   @db.VarChar(500)
  fileSize    Int
  fileType    String   @db.VarChar(50)
  mimeType    String   @db.VarChar(100)
  uploaderId  String?
  createdAt   DateTime @default(now())

  videoPosts  SocialMediaPost[] @relation("SocialMediaPostVideo")
  coverPosts  SocialMediaPost[] @relation("SocialMediaPostCover")

  @@index([uploaderId])
  @@index([fileType])
  @@index([createdAt])
  @@map("oss_files")
}

// ==================== 新媒体管理 ====================

model SocialMediaAccount {
  id          String   @id @default(uuid())
  platform    String   @db.VarChar(50)
  accountName String   @db.VarChar(100)
  accountId   String?  @db.VarChar(100)
  appId       String?  @db.VarChar(100)
  appSecret   String?  @db.VarChar(255)
  accessToken String?  @db.VarChar(500)
  refreshToken String? @db.VarChar(500)
  openId      String?  @db.VarChar(100)
  unionId     String?  @db.VarChar(100)
  expiresAt   DateTime?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       SocialMediaPost[]

  @@index([platform])
  @@index([status])
  @@map("social_media_accounts")
}

model SocialMediaPost {
  id           String   @id @default(uuid())
  accountId    String   @db.VarChar(36)
  title        String   @db.VarChar(200)
  content      String?  @db.Text
  videoFile    OssFile? @relation("SocialMediaPostVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  videoFileId  String?
  coverFile    OssFile? @relation("SocialMediaPostCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  coverFileId  String?
  videoUrl     String?  @db.VarChar(500)
  coverUrl     String?  @db.VarChar(500)
  topics       String?  @db.Text
  location     String?  @db.VarChar(200)
  visibility   String   @default("public") @db.VarChar(20)
  scheduledAt  DateTime?
  status       String   @default("draft") @db.VarChar(20)
  publishData  String?  @db.Text
  error        String?  @db.Text
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      SocialMediaAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("social_media_posts")
}

model SocialMediaPublishLog {
  id         String   @id @default(uuid())
  postId     String   @db.VarChar(36)
  platform   String   @db.VarChar(50)
  accountId  String   @db.VarChar(36)
  status     String   @default("pending") @db.VarChar(20)
  postIdOnPlatform String?  @db.VarChar(100)
  postUrl    String?  @db.VarChar(500)
  error      String?  @db.Text
  retryCount Int      @default(0)
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([postId])
  @@index([platform])
  @@index([status])
  @@map("social_media_publish_logs")
}

// ==================== 支付订单 ====================

model PaymentOrder {
  id              String   @id @default(uuid())
  contractId      String?
  orderNo         String   @unique @db.VarChar(50)
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @db.VarChar(50)
  paymentChannel  String?  @db.VarChar(50)
  status          String   @default("pending") @db.VarChar(20)
  qrCodeUrl       String?  @db.VarChar(500)
  qrCodeData      String?  @db.Text
  transactionId   String?  @db.VarChar(100)
  prepayId        String?  @db.VarChar(100)
  outTradeNo      String?  @db.VarChar(100)
  paidAt          DateTime?
  expiredAt       DateTime?
  clientIp        String?  @db.VarChar(50)
  returnUrl       String?  @db.VarChar(500)
  notifyUrl       String?  @db.VarChar(500)
  body            String?  @db.VarChar(200)
  attach          String?  @db.VarChar(500)
  error           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentId       String?

  @@index([contractId])
  @@index([orderNo])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payment_orders")
}

model PaymentConfig {
  id              String   @id @default(uuid())
  paymentMethod   String   @db.VarChar(50)
  paymentChannel  String   @db.VarChar(50)
  appId           String?  @db.VarChar(100)
  appSecret       String?  @db.VarChar(255)
  merchantId      String?  @db.VarChar(100)
  apiKey          String?  @db.VarChar(255)
  certPath        String?  @db.VarChar(500)
  notifyUrl       String?  @db.VarChar(500)
  returnUrl       String?  @db.VarChar(500)
  sandbox         Boolean  @default(false)
  status          Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentMethod])
  @@index([status])
  @@map("payment_configs")
}

model PaymentCallbackLog {
  id          String   @id @default(uuid())
  orderId     String   @db.VarChar(36)
  paymentMethod String @db.VarChar(50)
  status      String   @db.VarChar(20)
  rawData     String   @db.Text
  responseData String?  @db.Text
  error       String?  @db.Text
  ip          String?  @db.VarChar(50)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("payment_callback_logs")
}

// ==================== CMS 内容管理 ====================

model CmsContent {
  id          String      @id @default(uuid())
  title       String      @db.VarChar(200)
  slug        String      @unique @db.VarChar(200)
  content     String      @db.LongText
  excerpt     String?     @db.Text
  coverImage  String?     @db.VarChar(500)
  status      String      @default("DRAFT") @db.VarChar(20)
  contentType String      @db.VarChar(50)
  authorId    String      @db.VarChar(36)

  productId   String?
  userId      String?

  metaTitle   String?     @db.VarChar(200)
  metaDesc    String?     @db.VarChar(500)
  keywords    String?     @db.VarChar(500)

  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  author      User        @relation("CmsContentAuthor", fields: [authorId], references: [id])
  product     Product?    @relation("CmsProductShowcase", fields: [productId], references: [id])
  userProfile User?       @relation("CmsUserProfile", fields: [userId], references: [id])
  tags        CmsContentTag[]

  @@index([status])
  @@index([contentType])
  @@index([publishedAt])
  @@index([authorId])
  @@map("cms_contents")
}

model CmsTag {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  color       String?  @db.VarChar(20)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents    CmsContentTag[]

  @@index([sortOrder])
  @@map("cms_tags")
}

model CmsContentTag {
  contentId   String   @db.VarChar(36)
  tagId       String   @db.VarChar(36)
  createdAt   DateTime @default(now())

  content     CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag         CmsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([contentId])
  @@index([tagId])
  @@map("cms_content_tags")
}
