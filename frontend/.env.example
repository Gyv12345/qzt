# 环境配置示例
# 复制此文件为 .env.development.local 并修改相应配置

# 环境类型
NODE_ENV=development

# 前端服务端口
PORT=3456

# API 请求前缀（开发环境使用代理）
UMI_REQUEST_PREFIX=/api

# 后端服务地址（开发环境，前端通过代理访问）
BACKEND_URL=http://localhost:7890

# 生产环境示例
# NODE_ENV=production
# PORT=80
# UMI_REQUEST_PREFIX=/api
# BACKEND_URL=https://api.example.com
