# API Configuration
# Base URL for backend API (default: /api for Vite proxy, use full URL for production)
VITE_API_BASE_URL=/api

# Application Configuration
VITE_APP_TITLE=QZT Admin
VITE_APP_DESCRIPTION=企智通管理系统 - 企业客营管理平台

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_ANALYTICS=false

# Environment (development | production)
NODE_ENV=development
