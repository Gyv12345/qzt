# 本地开发敏感配置 —— 复制为 .env 并填入实际值。.env 不会被提交到 git。
# config.dev.yaml 用 ${VAR:-默认值} 引用这些变量；make run 会自动加载 .env。
# 注意：值含特殊字符（()!& 等）时必须加双引号，否则 shell source 会报语法错误。

# ===== 环境(dev/uat/prod) =====
APP_ENV=dev

# ===== MySQL =====
# 完整 DSN，覆盖 config.dev.yaml 的 mysql.dsn
MYSQL_DSN="root:CHANGE_ME@tcp(127.0.0.1:3306)/qztgo?charset=utf8mb4&parseTime=true&loc=Local&timeout=3s"

# ===== Redis =====
REDIS_ADDR="127.0.0.1:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# ===== JWT 密钥（生产环境务必改为强随机串，至少 32 字节）=====
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES"

# ===== 文件存储(可选) =====
STORAGE_DRIVER=local
# OSS_ENDPOINT=""
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
# OSS_BUCKET_NAME=""               # 公共桶(public-read)
# OSS_CUSTOM_DOMAIN=""
# OSS_PRIVATE_BUCKET_NAME=""       # 私有桶(private,留空则禁用私有附件)
# OSS_PRIVATE_CUSTOM_DOMAIN=""
