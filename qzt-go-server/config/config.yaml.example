# 配置模板：复制为 config/config.dev.yaml（或对应环境文件）后按需修改。
# 敏感字段在生产环境推荐用 ${VAR:-default} 占位符 + 环境变量注入，见 config/config.go 的 expandEnv。

application:
  enable_access_log: false
  enable_pprof: false
  server:
    name: qzt-server
    version: v1
    addr: 0.0.0.0
    port: 9000
    read_timeout: 30s
    write_timeout: 30s
    max_header_mb: 4

log:
  output: console          # console / file / multi
  access_encoder: normal   # normal / json
  log_encoder: normal      # normal / json
  access_file_max_age_days: 7
  log_file_max_age_days: 7

mysql:
  enable_read_write_separation: false
  # 生产环境：dsn: ${MYSQL_DSN}
  dsn: root:CHANGE_ME@tcp(127.0.0.1:3306)/qztgo?charset=utf8mb4&parseTime=true&loc=Local&timeout=3s
  mains_dsn: []
  slaves_dsn: []
  max_idle_conns: 4
  max_open_conns: 20
  conn_max_idle_time: 10m
  conn_max_life_time: 1h
  enable_sql_log: false
  slow_sql_threshold_time: 3s

redis:
  # 生产环境：addr: ${REDIS_ADDR}  password: ${REDIS_PASSWORD:-}
  addr: 127.0.0.1:6379
  password: ""
  db: 0
  dial_timeout: 2s
  read_timeout: 2s
  write_timeout: 2s
  idle_timeout: 60s
  min_idle_conns: 4
  pool_size: 10

jwt:
  issuer: qzt-server
  # 生产环境：jwt_secret: ${JWT_SECRET}（至少 32 字节）
  jwt_secret: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
  access_expiration_time: 2h
  refresh_expiration_time: 168h

storage:
  driver: local                          # local | oss
  local_path: ./storage/public           # 公共目录(driver=local,nginx 静态 serve)
  private_path: ./storage/private        # 私有目录(driver=local,后端代理鉴权访问)
  resource_domain: http://localhost:9000
  max_upload_mb: 20
  oss:                                   # driver=oss 时使用，敏感值通过 .env 注入
    endpoint: ${OSS_ENDPOINT:-}
    access_key_id: ${OSS_ACCESS_KEY_ID:-}
    access_key_secret: ${OSS_ACCESS_KEY_SECRET:-}
    bucket_name: ${OSS_BUCKET_NAME:-}                # 公共桶(public-read)
    custom_domain: ${OSS_CUSTOM_DOMAIN:-}            # 公共桶 CDN/自定义域名
    private_bucket_name: ${OSS_PRIVATE_BUCKET_NAME:-}        # 私有桶(留空则禁用私有附件)
    private_custom_domain: ${OSS_PRIVATE_CUSTOM_DOMAIN:-}    # 私有桶自定义域名

# 统一 LLM 网关(internal/pkg/llm):OpenAI 兼容协议,所有 AI 功能唯一调用入口。
# api_key 只走 .env 注入(LLM_API_KEY);留空=未配置,llm.Chat 返回 ErrNotConfigured。
# base_url 常用值:DeepSeek https://api.deepseek.com ;通义兼容模式 https://dashscope.aliyuncs.com/compatible-mode/v1
llm:
  base_url: ${LLM_BASE_URL:-https://api.deepseek.com}
  api_key: ${LLM_API_KEY:-}
  model: ${LLM_MODEL:-deepseek-chat}
  timeout: 60s
  max_retries: 2
  rpm: 120                  # 进程级每分钟最大请求数(令牌桶),0 不限流
  cache_ttl: 0s             # 相同请求响应缓存 TTL,0 关闭
  # P17 知识库 RAG：向量嵌入独立供应商(embedding 常与 chat 不同家),key 走 .env;api_key 留空=未配置,RAG 走降级路径
  embedding:
    base_url: ${KB_EMBEDDING_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}
    api_key: ${KB_EMBEDDING_API_KEY:-}
    model: ${KB_EMBEDDING_MODEL:-text-embedding-v3}
    timeout: 30s
    max_retries: 2

# AI 文生视频网关(internal/pkg/videogen):GEO 产线视频生产端,当前实现火山方舟即梦 Seedance。
# api_key 只走 .env 注入(VIDEOGEN_API_KEY);留空=未配置,产线视频步自动跳过。
# 开通入口:火山引擎方舟控制台开通 doubao-seedance 模型;计费按条(720p/5s 约 0.5 元)。
videogen:
  provider: ark
  base_url: ${VIDEOGEN_BASE_URL:-https://ark.cn-beijing.volces.com/api/v3}
  api_key: ${VIDEOGEN_API_KEY:-}
  model: ${VIDEOGEN_MODEL:-doubao-seedance-1-0-lite-t2v-250428}
  resolution: 720p          # 480p/720p/1080p
  duration_seconds: 5       # Seedance 支持 5/10
  ratio: 16:9               # 抖音竖屏改 9:16

# GEO 信源产线开关(internal/module/geo)。
geo:
  auto_push: true             # 定时产稿后自动推送公众号草稿箱(群发仍在 mp 后台人工确认)
  topic_auto_approve: false   # AI 生成的选题是否免审批直接进入产稿队列

# 搜索引擎主动推送(internal/pkg/searchpush,cms 模块/官网 SEO)。
# site 既是推送 URL 拼接前缀也是域名白名单;token/key 留空即对应通道禁用。
seo:
  site: "https://devlovecode.com"
  baidu_token: "${GEO_BAIDU_TOKEN:-}"     # 百度搜索资源平台 API 推送 token,只进 .env
  indexnow_key: "${SEO_INDEXNOW_KEY:-}"   # IndexNow 密钥,须与站点 /<key>.txt 文件一致,只进 .env
  daily_quota: 10                          # 每日兜底任务推给百度的最大条数(与百度每日配额对齐)

# Stripe 支付网关(internal/pkg/stripe,P28-B 独立站支付闭环,Test Mode 先行)。
# secret_key / webhook_secret 只走 .env 注入(STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET),
# 留空=未配置,checkout 返回「支付通道未配置」;storefront_site_url 拼成功/取消跳转地址。
stripe:
  secret_key: ${STRIPE_SECRET_KEY:-}
  webhook_secret: ${STRIPE_WEBHOOK_SECRET:-}
  storefront_site_url: ${STOREFRONT_SITE_URL:-http://localhost:5177}

# PayPal 支付网关(internal/pkg/paypal,P28-C 独立站第二支付通道,sandbox 先行)。
# client_id/secret 只走 .env(PAYPAL_CLIENT_ID / PAYPAL_SECRET),留空=未配置。
paypal:
  env: ${PAYPAL_ENV:-sandbox}
  client_id: ${PAYPAL_CLIENT_ID:-}
  secret: ${PAYPAL_SECRET:-}
  storefront_site_url: ${STOREFRONT_SITE_URL:-http://localhost:5177}

# 事务邮件 SMTP(internal/pkg/emailer,P28-C 独立站订单/询盘通知)。
# 全部只走 .env 注入(EMAIL_SMTP_*);留空=邮件通道关闭。
email:
  host: ${EMAIL_SMTP_HOST:-}
  port: ${EMAIL_SMTP_PORT:-465}
  username: ${EMAIL_SMTP_USERNAME:-}
  password: ${EMAIL_SMTP_PASSWORD:-}
  from: ${EMAIL_SMTP_FROM:-}
