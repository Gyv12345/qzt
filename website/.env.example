# ============================================================
# Website 环境变量配置
# ============================================================

# ---------------------
# API 配置（客户端可访问）
# ---------------------
# 后端 API 地址（浏览器端可访问）
NEXT_PUBLIC_API_URL=http://localhost:7890

# ---------------------
# Node 环境
# ---------------------
# 运行环境: development | production
NODE_ENV=production

# ---------------------
# 服务器配置
# ---------------------
# 应用端口
PORT=5180

# 监听地址（Docker 部署时使用）
HOSTNAME=0.0.0.0

# ---------------------
# Next.js 配置
# ---------------------
# 禁用遥测（推荐生产环境启用）
NEXT_TELEMETRY_DISABLED=1

# ---------------------
# 图片优化配置（可选）
# ---------------------
# 图片域名白名单（逗号分隔，留空则允许所有 HTTPS 域名）
# NEXT_PUBLIC_IMAGE_DOMAINS=example.com,cdn.example.com

# ---------------------
# ISR 缓存配置（可选）
# ---------------------
# 重新验证时间（秒），用于 ISR 页面
# NEXT_PUBLIC_REVALIDATE_TIME=3600
